{
  "name": "@wako-app/mobile-sdk",
  "version": "11.0.0",
  "description": "wako's mobile SDK",
  "main": "dist/public_api.js",
  "typings": "dist/public_api.d.ts",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/wako-app/mobile-sdk"
  },
  "bugs": {
    "url": "https://github.com/wako-app/mobile-sdk/issues"
  },
  "homepage": "https://github.com/wako-app/mobile-sdk/issues#readme",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "start": "tsc -w",
    "export-modules": "ts-node --project ./scripts/tsconfig.json ./scripts/export-all-module.ts",
    "clean": "rm -rf dist",
    "build:builders": "tsc -p builders/tsconfig.builders.json",
    "copy:builders": "cp -r ./builders ./dist",
    "build:lib": "tsc && node ./scripts/add-wako-in-plugin.js",
    "build": "pnpm export-modules && rm -rf dist && pnpm build:lib && rm ./src/public_api.ts && cp ./src/manifest-schema.json ./dist",
    "prepare": "pnpm build && husky install",
    "publish": "pnpm build && pnpm publish",
    "publish:next": "pnpm build && pnpm publish --tag next --no-git-checks"
  },
  "keywords": [
    "wako",
    "sdk",
    "mobile"
  ],
  "author": "wako",
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.3",
    "@angular/common": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@capacitor/app-launcher": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/share": "^7.0.2",
    "@ionic/angular": "^8.7.3",
    "@ionic/storage-angular": "^4.0.0",
    "@ngx-translate/core": "^17.0.0",
    "cordova-sqlite-storage": "^6.1.0",
    "ionicons": "^8.0.13",
    "localforage-cordovasqlitedriver": "^1.8.0",
    "rxjs": "^7.8.2",
    "systemjs": "^6.15.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.1",
    "@angular-eslint/builder": "20.3.0",
    "@angular-eslint/eslint-plugin": "20.3.0",
    "@angular-eslint/eslint-plugin-template": "20.3.0",
    "@angular-eslint/schematics": "20.3.0",
    "@angular-eslint/template-parser": "20.3.0",
    "@angular/cli": "^20.3.1",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/language-service": "^20.3.0",
    "@types/glob": "^8.1.0",
    "@types/node": "^24.3.1",
    "glob": "^9.3.2",
    "husky": "^9.1.7",
    "karma": "~6.4.1",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "@angular/cdk": ">=20",
    "@angular/common": ">=20",
    "@angular/core": ">=20",
    "@angular/forms": ">=20",
    "@angular/router": ">=20",
    "@capacitor/app-launcher": ">=7",
    "@capacitor/browser": ">=7",
    "@capacitor/core": ">=7",
    "@capacitor/share": ">=7",
    "@ionic/angular": ">=8",
    "@ionic/storage-angular": ">=4.0.0",
    "@ngx-translate/core": ">=17.0.0",
    "cordova-sqlite-storage": "^6.1.0",
    "ionicons": "^7.4.0",
    "localforage-cordovasqlitedriver": "^1.8.0",
    "rxjs": "^7.8.2",
    "systemjs": "^6.12.1",
    "tslib": "^2.3.1"
  }
}
